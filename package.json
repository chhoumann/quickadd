{
	"name": "quickadd",
	"version": "2.32.1",
	"description": "Quickly add new pages or content to your vault.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"lint": "pnpm run \"/^(lint:.+|check)$/\"",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build-with-lint": "pnpm lint && node esbuild.config.mjs production",
		"check": "svelte-check --tsgo-experimental-api --fail-on-warnings",
		"packages:build": "node docs/packages/build.mjs",
		"obsidian:e2e": "obsidian-e2e run",
		"provision:e2e-vault": "obsidian-e2e provision",
		"start:e2e-obsidian": "obsidian-e2e start",
		"stop:e2e-obsidian": "obsidian-e2e stop",
		"test": "vitest run --config vitest.config.mts --passWithNoTests",
		"test:coverage": "vitest run --config vitest.config.mts --coverage",
		"test:e2e": "vitest run --config vitest.e2e.config.mts",
		"test:e2e:orb": ".agents/run-e2e",
		"lint:native": "oxlint -c .oxlintrc.syntax.json src tests && oxlint --type-aware --ignore-pattern '**/*.test.ts' src",
		"lint:svelte": "node tooling/svelte-policy.mjs",
		"lint:tsconfig": "tsc --noEmit --noCheck"
	},
	"keywords": [],
	"author": "Christian B. B. Houmann",
	"license": "MIT",
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitest/coverage-v8": "5.0.3",
		"esbuild": "^0.28.2",
		"esbuild-svelte": "^0.9.5",
		"esquery": "^1.7.0",
		"jsdom": "^30.1.2",
		"moment": "2.31.0",
		"obsidian": "1.14.4",
		"obsidian-e2e": "^0.13.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2004",
		"svelte": "^5.57.2",
		"svelte-check": "4.7.6",
		"tslib": "^2.8.1",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"yaml": "2.9.1"
	},
	"dependencies": {
		"chrono-node": "^2.10.3",
		"fuse.js": "^7.5.0",
		"svelte-dnd-action": "0.9.80",
		"three-way-merge": "^0.1.0",
		"zustand": "^5.0.15"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/chhoumann/quickadd.git"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"overrides": {
			"brace-expansion": "5.0.9",
			"postcss": "8.5.25"
		},
		"patchedDependencies": {
			"svelte-check@4.7.6": "patches/svelte-check@4.7.6.patch"
		}
	}
}
