#!/usr/bin/env bash
# Builds main.js and runs the native E2E suite in this worktree's isolated
# Obsidian instance. Arguments go to Vitest (a spec path, `-t <name>`).
#
# OBSIDIAN_E2E_TEMPLATER=1 also runs the Templater-only specs, against the
# Templater release pinned below. Run it that way for any change that touches
# a Templater path: CI runs no native specs, so nothing else catches those.
set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly REPO_ROOT="$(dirname -- "$SCRIPT_DIR")"
readonly ORIGINAL_HOME="$HOME"
export COREPACK_HOME="${COREPACK_HOME:-$ORIGINAL_HOME/.cache/quickadd-corepack}"

cd "$REPO_ROOT"

# `pnpm install` rewrites obsidian-e2e's dist, which drops the orb's Linux
# launcher patch that .agents/setup applied. Reapply it (idempotent) so a
# dependency bump mid-session doesn't stop the suite from starting.
if [[ -e /opt/Obsidian/resources/obsidian.asar ]]; then
	node "$SCRIPT_DIR/patch-obsidian-e2e-linux.mjs" >/dev/null
fi

# The runner loads whatever main.js is on disk. Build it from the checked-out
# source so a stale bundle can't pass or fail a run for code it doesn't hold.
pnpm run --silent build >/dev/null

cleanup() {
	local status=$?
	trap - EXIT INT TERM
	if ! HOME="$ORIGINAL_HOME" pnpm run --silent stop:e2e-obsidian; then
		echo "Failed to stop the isolated Obsidian E2E instance." >&2
		if ((status == 0)); then status=1; fi
	fi
	exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Keep assignment and status checking separate from parsing. Command
# substitution inside `eval` would otherwise let eval's success mask a runner
# that printed plausible exports and then exited nonzero.
start_output=""
if start_output="$(pnpm run --silent start:e2e-obsidian -- --print-env)"; then
	:
else
	start_status=$?
	echo "Failed to start the isolated Obsidian E2E instance (status $start_status)." >&2
	exit "$start_status"
fi

# Parse the runner's narrow export contract instead of evaluating shell text.
# Values containing quotes/newlines are rejected; E2E paths and vault names do
# not require shell syntax.
declare -A start_env=()
while IFS= read -r line; do
	if [[ ! "$line" =~ ^export\ ([A-Z0-9_]+)=\'([^\']*)\'$ ]]; then
		echo "Invalid start environment output: $line" >&2
		exit 1
	fi
	name="${BASH_REMATCH[1]}"
	value="${BASH_REMATCH[2]}"
	case "$name" in
		OBSIDIAN_E2E_VAULT|OBSIDIAN_E2E_VAULT_PATH|OBSIDIAN_E2E_OBSIDIAN_HOME|QUICKADD_E2E_VAULT|QUICKADD_E2E_VAULT_PATH|QUICKADD_E2E_OBSIDIAN_HOME|OBSIDIAN_BIN) ;;
		*) echo "Unexpected start environment variable: $name" >&2; exit 1 ;;
	esac
	[[ ! -v "start_env[$name]" ]] || {
		echo "Duplicate start environment variable: $name" >&2
		exit 1
	}
	start_env["$name"]="$value"
done <<< "$start_output"

for name in OBSIDIAN_E2E_VAULT OBSIDIAN_E2E_VAULT_PATH OBSIDIAN_E2E_OBSIDIAN_HOME \
	QUICKADD_E2E_VAULT QUICKADD_E2E_VAULT_PATH QUICKADD_E2E_OBSIDIAN_HOME; do
	[[ -n "${start_env[$name]:-}" ]] || {
		echo "Missing start environment variable: $name" >&2
		exit 1
	}
done
[[ "${start_env[OBSIDIAN_E2E_VAULT]}" == "${start_env[QUICKADD_E2E_VAULT]}" && \
	"${start_env[OBSIDIAN_E2E_VAULT_PATH]}" == "${start_env[QUICKADD_E2E_VAULT_PATH]}" && \
	"${start_env[OBSIDIAN_E2E_OBSIDIAN_HOME]}" == "${start_env[QUICKADD_E2E_OBSIDIAN_HOME]}" ]] || {
	echo "Canonical and legacy start environment values disagree." >&2
	exit 1
}
vault_path="${start_env[OBSIDIAN_E2E_VAULT_PATH]}"
obsidian_home="${start_env[OBSIDIAN_E2E_OBSIDIAN_HOME]}"
expected_vault_root="$(realpath -e -- "$REPO_ROOT/.obsidian-e2e-vaults")"
profile_root="$(realpath -e -- /tmp/quickadd-obsidian-e2e)"
if [[ ! -d "$vault_path" || "$(realpath -e -- "$vault_path")" != "$vault_path" || \
	"$(dirname -- "$vault_path")" != "$expected_vault_root" || \
	! -d "$obsidian_home" || "$(realpath -e -- "$obsidian_home")" != "$obsidian_home" || \
	"$(basename -- "$obsidian_home")" != "home" || \
	"$(dirname -- "$(dirname -- "$obsidian_home")")" != "$profile_root" ]]; then
	echo "Start environment paths are not canonical isolated E2E paths." >&2
	exit 1
fi
for name in "${!start_env[@]}"; do
	printf -v "$name" '%s' "${start_env[$name]}"
	export "$name"
done

export HOME="$OBSIDIAN_E2E_OBSIDIAN_HOME"

if [[ "${OBSIDIAN_E2E_TEMPLATER:-}" == "1" ]]; then
	# The runner resets community-plugins.json on every start, so install the
	# pinned release into the isolated vault and enable it in the running app.
	templater_version="2.25.1"
	declare -A templater_sha256=(
		[main.js]=eb86d9282694ce1f099154c320286fdd89473e60dc2441ee310f3ac331333e94
		[manifest.json]=b99280d2c4ab2cd22ad010c12faeedf255bcf385d127d973b89f85deb27d23fd
		[styles.css]=67a6dd2d1d6dedca1287c334ca884ec4196433f71ca47388a0bd3eac14cf8b5f
	)
	templater_cache="$ORIGINAL_HOME/.cache/quickadd-templater/$templater_version"
	templater_dir="$vault_path/.obsidian/plugins/templater-obsidian"
	mkdir -p "$templater_cache" "$templater_dir"
	for file in "${!templater_sha256[@]}"; do
		if [[ ! -f "$templater_cache/$file" ]]; then
			# A download of its own, so a concurrent run in another worktree can't
			# move or truncate it mid-write.
			part="$(mktemp "$templater_cache/$file.XXXXXX")"
			curl -sSfL -o "$part" \
				"https://github.com/SilentVoid13/Templater/releases/download/$templater_version/$file"
			mv "$part" "$templater_cache/$file"
		fi
		echo "${templater_sha256[$file]}  $templater_cache/$file" | sha256sum --check --quiet
		cp "$templater_cache/$file" "$templater_dir/$file"
	done
	# A reused instance may already run a Templater, and enabling a loaded
	# plugin keeps its code, so unload it first.
	enabled="$(pnpm run --silent obsidian:e2e -- eval code='(async () => {
		await app.plugins.loadManifests();
		await app.plugins.disablePlugin("templater-obsidian");
		await app.plugins.enablePlugin("templater-obsidian");
		return app.plugins.plugins["templater-obsidian"]?.manifest.version ?? "missing";
	})()')"
	if [[ "$enabled" != "=> $templater_version" ]]; then
		echo "Could not enable Templater $templater_version: $enabled" >&2
		exit 1
	fi
fi

# No `--`: pnpm passes it through, and Vitest ignores everything after it, so
# file and `-t` filters would silently run the whole suite.
pnpm run test:e2e "$@"
