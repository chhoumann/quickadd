{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "framework": null,
  "redirects": [
    {
      "source": "/docs/next/:path*",
      "destination": "/docs/:path*",
      "permanent": true
    },
    {
      "source": "/docs/:version(\\d+\\.\\d+\\.\\d+)/:path*",
      "destination": "/docs/:path*",
      "permanent": true
    }
  ]
}
