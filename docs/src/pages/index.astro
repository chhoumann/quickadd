---
// QuickAdd landing page. Static; the only client JS is the theme sync snippet
// and the demo stepper, and the page reads fine without either.
const description =
	"QuickAdd for Obsidian: create notes from templates, append to the notes you already have, and chain steps into macros, each one a choice you can run from anywhere.";

// The demo frames are unedited captures of QuickAdd running in Obsidian, taken
// at 1200x720 CSS px and 2x density, one light and one dark capture per step.
// Each flow runs the choice described by its `recipe`.
const demoFlows = [
	{
		id: "capture",
		label: "Add to a note",
		icon: "pencil",
		recipe: {
			label: "The choice in this demo",
			rows: [
				{ label: "Capture to", value: "Daily/{{DATE:YYYY-MM-DD}}.md" },
				{ label: "Create file if it doesn’t exist", value: "On" },
				{ label: "Insert after", value: "## Log", note: "at end of section" },
				{ label: "Capture format", value: "- {{DATE:HH:mm}} {{VALUE}}\\n" },
			],
			link: { label: "Follow the recipe", href: "/docs/Examples/Capture_ToDailyNote/" },
		},
		steps: [
			{
				id: "pick",
				title: "Pick a choice",
				description:
					"Run <strong>QuickAdd: Run</strong> from the command palette, or give the choice a hotkey of its own.",
				alt: "Obsidian with QuickAdd's choice picker open over a daily note, listing Log to daily note, Add task to inbox, New meeting note, Add book by title, Save quote, and a Projects folder.",
			},
			{
				id: "type",
				title: "Type the entry",
				description: "A capture asks only for what it needs, and shows the note it will write to.",
				alt: "QuickAdd's input prompt titled Log to daily note, showing the target Daily/2026-09-26.md and the entry Booked the plumber for Tuesday morning.",
			},
			{
				id: "done",
				title: "It lands in place",
				description:
					"Timestamped and filed under <code>## Log</code> in today’s note, which is created if it doesn’t exist yet.",
				alt: "The daily note with a new timestamped line, Booked the plumber for Tuesday morning, at the end of the Log section, and a notice reading Captured to 2026-09-26 under Log.",
			},
		],
	},
	{
		id: "template",
		label: "Create a note",
		icon: "fileText",
		recipe: {
			label: "The choice in this demo",
			rows: [
				{ label: "Template path", value: "Templates/Meeting.md" },
				{ label: "File name format", value: "{{DATE:YYYY-MM-DD}} {{VALUE:Meeting}}" },
				{ label: "Folder", value: "Meetings" },
				{ label: "Open", value: "On" },
			],
			link: { label: "Template choices", href: "/docs/Choices/TemplateChoice/" },
		},
		steps: [
			{
				id: "pick",
				title: "Find it by name",
				description: "Type to filter. Choices inside folders show up too, with their folder underneath.",
				alt: "QuickAdd's choice picker filtered by the query new, showing New meeting note and New project from the Projects folder.",
			},
			{
				id: "type",
				title: "Name the meeting",
				description: "The answer fills in the file name. The prompt shows the folder the note goes to.",
				alt: "QuickAdd's input prompt titled Meeting, showing New meeting note going to Meetings/ and the answer Website planning.",
			},
			{
				id: "done",
				title: "Start typing",
				description:
					"The note opens with its properties set, and the cursor waits at <code>{{CURSOR}}</code>.",
				alt: "A new note, 2026-09-26 Website planning, in the Meetings folder with date and tags properties, and the first line typed under Notes.",
			},
		],
	},
];

// Icons match the defaults QuickAdd itself shows for each choice type.
const choiceTypes = [
	{
		name: "Template",
		icon: "fileText",
		description: "Create a note from a template file, named and filed where it belongs.",
		example: "a dated meeting note in Meetings/",
		href: "/docs/Choices/TemplateChoice/",
	},
	{
		name: "Capture",
		icon: "pencil",
		description: "Add text to a note that already exists: at the cursor, at the top or bottom, or under a heading.",
		example: "a timestamped line in today’s daily note",
		href: "/docs/Choices/CaptureChoice/",
	},
	{
		name: "Macro",
		icon: "terminal",
		description: "Chain Obsidian commands, user scripts, and other choices into a single step.",
		example: "look up a book and write its note",
		href: "/docs/Choices/MacroChoice/",
	},
	{
		name: "Multi",
		icon: "folder",
		description: "Group choices into folders and build a menu that fits the way you work.",
		example: "a Projects folder with its own choices",
		href: "/docs/Choices/MultiChoice/",
	},
];

const further = [
	{
		title: "Format syntax",
		description: "Dates, prompts, links, and clipboard contents, filled in each run.",
		href: "/docs/FormatSyntax/",
	},
	{
		title: "Scripts and API",
		description: "Write user scripts in JavaScript and call QuickAdd from them.",
		href: "/docs/Advanced/ScriptingGuide/",
	},
	{
		title: "AI Assistant",
		description: "Send a prompt from a macro and use the reply in later steps.",
		href: "/docs/AIAssistant/",
	},
	{
		title: "Obsidian URI",
		description: "Run choices from outside Obsidian and pass values in.",
		href: "/docs/Advanced/ObsidianUri/",
	},
];

const examples = [
	{
		type: "Capture",
		icon: "pencil",
		title: "Daily note entries",
		description:
			"Timestamped lines, tasks, quotes, and callouts under a heading in today’s note.",
		href: "/docs/Examples/Capture_ToDailyNote/",
	},
	{
		type: "Template",
		icon: "fileText",
		title: "Meeting notes",
		description:
			"Create a dated meeting note, answer one question, and start typing under Notes.",
		href: "/docs/Examples/Template_MeetingNotes/",
	},
	{
		type: "Macro",
		icon: "terminal",
		title: "Book notes from a title",
		description:
			"Look a book up in Google Books and create its note. No API key needed.",
		href: "/docs/Examples/Macro_BookFinder/",
	},
	{
		type: "Capture",
		icon: "pencil",
		title: "Kanban cards",
		description:
			"Drop a card into any lane of a Kanban board without opening the board.",
		href: "/docs/Examples/Capture_AddTaskToKanbanBoard/",
	},
];

const steps = [
	{
		title: "Install",
		description: "Find QuickAdd in Settings → Community plugins and enable it.",
	},
	{
		title: "Create a choice",
		description: "In Settings → QuickAdd, click New choice and pick a type.",
	},
	{
		title: "Run it",
		description: "Use QuickAdd: Run from the command palette, or bind the choice to a hotkey with ⚡.",
	},
];

// Lucide icon paths (24x24, currentColor stroke).
const icons: Record<string, string> = {
	fileText:
		'<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M10 9H8" /><path d="M16 13H8" /><path d="M16 17H8" />',
	pencil:
		'<path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" /><path d="m15 5 4 4" />',
	terminal: '<polyline points="4 17 10 11 4 5" /><line x1="12" x2="20" y1="19" y2="19" />',
	folder:
		'<path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2" />',
	moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />',
	sun: '<circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />',
	github:
		'<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" />',
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>QuickAdd for Obsidian</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/img/favicon.ico" />
		<link rel="canonical" href="https://quickadd.obsidian.guide/" />
		<meta property="og:title" content="QuickAdd for Obsidian" />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://quickadd.obsidian.guide/img/og-home.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="QuickAdd: One hotkey from thought to note. Its choice picker open in Obsidian."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://quickadd.obsidian.guide/" />
		<meta name="twitter:card" content="summary_large_image" />
		<link
			rel="preload"
			href="/fonts/InterVariable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<script is:inline>
			// Follow the docs' Starlight theme choice; fall back to the OS scheme,
			// and keep following it while the page is open. Then preload the first
			// demo frame for that theme only: the frames themselves are lazy, so
			// the theme that isn't showing never downloads.
			(() => {
				const root = document.documentElement;
				const media = window.matchMedia("(prefers-color-scheme: dark)");
				const stored = () => {
					try {
						const value = localStorage.getItem("starlight-theme");
						return value === "light" || value === "dark" ? value : null;
					} catch {
						return null;
					}
				};
				const apply = () => {
					root.dataset.theme = stored() ?? (media.matches ? "dark" : "light");
				};
				apply();
				media.addEventListener("change", apply);

				const preload = document.createElement("link");
				preload.rel = "preload";
				preload.as = "image";
				preload.fetchPriority = "high";
				preload.href = `/img/home/capture-pick-${root.dataset.theme}.webp`;
				document.head.append(preload);
			})();
		</script>
	</head>
	<body>
		<div class="landing">
			<header class="siteHeader">
				<nav class="container siteNav" aria-label="Main">
					<a class="brand" href="/">
						<img src="/img/quickadd-icon.png" alt="" width="26" height="26" />
						<span>QuickAdd</span>
					</a>
					<div class="navLinks">
						<a href="/docs/">Docs</a>
						<a class="navOptional" href="/docs/Examples/">Examples</a>
						<a class="navOptional" href="/docs/QuickAddAPI/">API</a>
						<a
							class="navGithub"
							href="https://github.com/chhoumann/quickadd"
							aria-label="QuickAdd on GitHub">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								set:html={icons.github}
							/>
						</a>
						<button class="themeToggle" type="button" data-theme-toggle aria-label="Toggle dark theme">
							<svg
								class="iconMoon"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								set:html={icons.moon}
							/>
							<svg
								class="iconSun"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								set:html={icons.sun}
							/>
						</button>
					</div>
				</nav>
			</header>

			<main>
				<section class="hero">
					<div class="container">
						<img
							src="/img/quickadd-icon.png"
							alt=""
							class="heroLogo"
							width="64"
							height="64"
						/>
						<p class="eyebrow">A plugin for Obsidian</p>
						<h1 class="heroTitle">One hotkey from thought to note.</h1>
						<p class="heroSubtitle">
							QuickAdd creates notes from templates, adds to the notes you already
							have, and chains steps into macros. Each one is a choice you can run from
							anywhere in your vault.
						</p>
						<div class="heroActions">
							<a class="buttonPrimary" href="/docs/">Get started</a>
							<a class="buttonSecondary" href="https://obsidian.md/plugins?id=quickadd">
								View in Obsidian’s plugin directory
							</a>
						</div>
					</div>

					<section class="demo container" data-demo aria-label="QuickAdd in action">
						<div class="demoControls">
							<div class="demoTabs" role="group" aria-label="Demo">
								{
									demoFlows.map((flow, f) => (
										<button
											class="demoTab"
											type="button"
											data-flow={flow.id}
											aria-current={f === 0 ? "true" : undefined}>
											<svg
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="1.75"
												stroke-linecap="round"
												stroke-linejoin="round"
												aria-hidden="true"
												set:html={icons[flow.icon]}
											/>
											{flow.label}
										</button>
									))
								}
							</div>
							<button class="demoPlay" type="button" data-demo-play aria-label="Pause demo" hidden>
								<svg class="iconPause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<rect x="6" y="5" width="4" height="14" rx="1" />
									<rect x="14" y="5" width="4" height="14" rx="1" />
								</svg>
								<svg class="iconPlay" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M7 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 7 5.5Z" />
								</svg>
							</button>
						</div>
						<div class="demoFrame">
							{
								demoFlows.map((flow, f) =>
									flow.steps.map((step, i) => {
										const active = f === 0 && i === 0;
										return (
											<div
												class:list={["demoShot", { isActive: active, isNext: f === 0 && i === 1 }]}
												data-flow={flow.id}
												data-index={i}
												aria-hidden={active ? undefined : "true"}>
												{["light", "dark"].map((theme) => (
													<img
														class={theme === "light" ? "shotLight" : "shotDark"}
														src={`/img/home/${flow.id}-${step.id}-${theme}.webp`}
														alt={step.alt}
														width="1200"
														height="720"
														loading="lazy"
														decoding="async"
													/>
												))}
											</div>
										);
									}),
								)
							}
						</div>
						<div class="demoCaption">
							{
								demoFlows.map((flow, f) => (
									<div
										class:list={["demoFlow", { isActive: f === 0 }]}
										data-flow={flow.id}
										inert={f === 0 ? undefined : true}>
										<ol class="demoSteps">
											{flow.steps.map((step, i) => (
												<li>
													<button
														class="demoStep"
														type="button"
														data-flow={flow.id}
														data-index={i}
														aria-current={f === 0 && i === 0 ? "step" : undefined}
														aria-describedby={`demo-${flow.id}-${step.id}`}>
														<span class="demoProgress" aria-hidden="true" />
														<span class="demoStepTitle">
															<span class="demoStepNumber">{i + 1}</span>
															{step.title}
														</span>
													</button>
													<p
														class="demoStepDesc"
														id={`demo-${flow.id}-${step.id}`}
														set:html={step.description}
													/>
												</li>
											))}
										</ol>
										<div class="demoRecipe">
											<p class="demoRecipeLabel">{flow.recipe.label}</p>
											<dl>
												{flow.recipe.rows.map((row) => (
													<div>
														<dt>{row.label}</dt>
														<dd>
															{row.value === "On" ? row.value : <code>{row.value}</code>}
															{row.note && <span class="demoRecipeNote">{row.note}</span>}
														</dd>
													</div>
												))}
											</dl>
											<a href={flow.recipe.link.href}>{flow.recipe.link.label} →</a>
										</div>
									</div>
								))
							}
						</div>
					</section>
				</section>

				<section class="section">
					<div class="container">
						<div class="sectionHead">
							<p class="eyebrow">Choices</p>
							<h2 class="sectionTitle">Every workflow starts with one of four choices.</h2>
						</div>
						<ul class="choiceTypes" role="list">
							{
								choiceTypes.map((c) => (
									<li>
										<a class="choiceType" href={c.href}>
											<span class="choiceIcon" aria-hidden="true">
												<svg
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="1.75"
													stroke-linecap="round"
													stroke-linejoin="round"
													set:html={icons[c.icon]}
												/>
											</span>
											<span class="choiceName">{c.name}</span>
											<span class="choiceDesc">{c.description}</span>
											<span class="choiceExample">{c.example}</span>
										</a>
									</li>
								))
							}
						</ul>

						<div class="further">
							<h3 class="furtherTitle">When you need more</h3>
							<ul class="furtherList" role="list">
								{
									further.map((f) => (
										<li>
											<a href={f.href}>
												<span class="furtherName">{f.title}</span>
												<span class="furtherDesc">{f.description}</span>
											</a>
										</li>
									))
								}
							</ul>
						</div>
					</div>
				</section>

				<section class="section">
					<div class="container">
						<div class="sectionHead sectionHeadSplit">
							<div>
								<p class="eyebrow">Examples</p>
								<h2 class="sectionTitle">Start from a working recipe.</h2>
							</div>
							<a class="textLink" href="/docs/Examples/">All examples →</a>
						</div>
						<ul class="examples" role="list">
							{
								examples.map((e) => (
									<li>
										<a class="example" href={e.href}>
											<span class="exampleType">
												<svg
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="1.75"
													stroke-linecap="round"
													stroke-linejoin="round"
													aria-hidden="true"
													set:html={icons[e.icon]}
												/>
												{e.type}
											</span>
											<span class="exampleTitle">{e.title}</span>
											<span class="exampleDesc">{e.description}</span>
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</section>

				<section class="section quickStart">
					<div class="container">
						<div class="sectionHead">
							<p class="eyebrow">Get started</p>
							<h2 class="sectionTitle">Running in three steps.</h2>
						</div>
						<ol class="steps" role="list">
							{
								steps.map((s, i) => (
									<li class="step">
										<span class="stepNumber" aria-hidden="true">
											{i + 1}
										</span>
										<h3 class="stepTitle">{s.title}</h3>
										<p class="stepDesc">{s.description}</p>
									</li>
								))
							}
						</ol>
						<div class="quickStartCta">
							<a class="buttonPrimary" href="/docs/">Read the guide</a>
							<a class="buttonSecondary" href="/docs/Examples/">Browse examples</a>
						</div>
					</div>
				</section>
			</main>

			<footer class="siteFooter">
				<div class="container footerGrid">
					<div class="footerBrand">
						<img src="/img/quickadd-icon.png" alt="" width="22" height="22" />
						<span>QuickAdd</span>
					</div>
					<div>
						<p class="footerTitle">Docs</p>
						<ul role="list">
							<li><a href="/docs/">Getting started</a></li>
							<li><a href="/docs/Examples/">Examples</a></li>
							<li><a href="/docs/QuickAddAPI/">API reference</a></li>
						</ul>
					</div>
					<div>
						<p class="footerTitle">Community</p>
						<ul role="list">
							<li><a href="https://github.com/chhoumann/quickadd">GitHub</a></li>
							<li><a href="https://github.com/chhoumann/quickadd/discussions">Discussions</a></li>
							<li><a href="https://github.com/chhoumann/quickadd/issues">Report an issue</a></li>
						</ul>
					</div>
					<div>
						<p class="footerTitle">Support</p>
						<ul role="list">
							<li><a href="https://buymeacoffee.com/chhoumann">Buy me a coffee</a></li>
						</ul>
					</div>
				</div>
				<div class="container">
					<p class="footerMeta">
						© {new Date().getFullYear()} Christian Bager Bach Houmann. Free and open source under
						the MIT license.
					</p>
				</div>
			</footer>
		</div>

		<script is:inline>
			// Theme toggle. Writes the key Starlight uses, so the docs follow. When
			// the pick matches the OS setting it clears the key instead, so the
			// site goes back to following the OS.
			(() => {
				const root = document.documentElement;
				const toggle = document.querySelector("[data-theme-toggle]");
				const media = window.matchMedia("(prefers-color-scheme: dark)");
				const label = () =>
					toggle.setAttribute(
						"aria-label",
						root.dataset.theme === "dark" ? "Switch to light theme" : "Switch to dark theme",
					);
				label();
